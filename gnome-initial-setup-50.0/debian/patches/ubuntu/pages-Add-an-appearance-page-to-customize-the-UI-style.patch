index 0000000..2d6af2e
--- /dev/null
+++ b/gnome-initial-setup/pages/appearance/gis-appearance-page.c
@@ -0,0 +1,513 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*- */
+/*
