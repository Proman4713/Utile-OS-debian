+blueprint_compiler = find_program('blueprint-compiler')
+
+gsettings_desktop_dep = dependency('gsettings-desktop-schemas', version: '>= 3.37.1')
+
+enum_sources = gnome.mkenums_simple(
+    'cc-background-enum-types',
+    sources: files('cc-background-item.h', 'cc-background-paintable.h'),
+    install_header: false,
+)
+
+gdesktop_enums_header = files(
+    gsettings_desktop_dep.get_variable(pkgconfig: 'prefix') +
+        '/include/gsettings-desktop-schemas/gdesktop-enums.h'
+)
+add_project_arguments('-I' +
+    meson.build_root() / meson.current_source_dir(), language: 'c')
+
+enum_sources += gnome.mkenums_simple(
+    'gdesktop-enums-types',
+    sources: gdesktop_enums_header,
+    identifier_prefix: 'GDesktop',
+    symbol_prefix: 'g_desktop',
+    install_header: false,
+)
+
+blueprints = custom_target(
