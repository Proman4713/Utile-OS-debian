+static const char *
+get_translated_service_description (const char *service_name)
+{
+  for (unsigned i = 0; i < G_N_ELEMENTS (service_names); ++i)
+    if (g_strcmp0 (service_name, service_names[i].name) == 0)
+      return service_names[i].description;
