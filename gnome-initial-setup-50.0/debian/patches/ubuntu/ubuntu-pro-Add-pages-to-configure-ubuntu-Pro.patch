+{
+  AdwStyleManager *style_manager;
+  GisUbuntuProPage *page = GIS_UBUNTUPRO_PAGE (object);
+  GisUbuntuProPagePrivate *priv = gis_ubuntupro_page_get_instance_private (page);
+
+  g_autoptr(GtkCssProvider) css_provider = NULL;
