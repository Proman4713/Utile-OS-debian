diff --git a/gnome-initial-setup/pages/ubuntu-pro/gis-ubuntupro-services-page.blp b/gnome-initial-setup/pages/ubuntu-pro/gis-ubuntupro-services-page.blp
new file mode 100644
index 0000000..3524c86
--- /dev/null
+++ b/gnome-initial-setup/pages/ubuntu-pro/gis-ubuntupro-services-page.blp
@@ -0,0 +1,57 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $GisUbuntuProServicesPage: Adw.Bin {
+  Adw.PreferencesPage {
+    Adw.PreferencesGroup {
+      Adw.Clamp {
+        margin-top: 20;
+        maximum-size: 300;
+
+        child: Picture ubuntu_pro_logo {
+          valign: start;
+          content-fit: scale_down;
+          can-shrink: true;
+          height-request: 75;
+        };
+      }
+    }
+
+    Adw.PreferencesGroup {
+      $GisPageHeader header {
+        title: _("Ubuntu Pro Services");
+        show-icon: false;
+        use-accessible-title: true;
+      }
+    }
+
+    Adw.PreferencesGroup subscription-group {
+      title: _("Your subscription");
+      accessible-role: group;
+
+      Adw.ActionRow contract_name {
+        can-focus: true;
+
+        [suffix]
+        Image checkmark {
+          icon-name: "pro-checkmark";
+          pixel-size: 22;
+        }
+      }
+    }
+
+    Adw.PreferencesGroup enabled_services_header {
+      title: _("Your enabled services");
+      /* Translators: translators: Use HTML encoded format for special characters such as '&' */
+      description: _(
+            "You can change the default enablements for your token on the ubuntu.com/pro web interface. You can also change enabled services in the Settings menu or with the `<span font_family='monospace'>pro</span>` command-line."
+          );
+      accessible-role: group;
+    }
+
+    Adw.PreferencesGroup available_services_header {
+      title: _("Other available services");
+      accessible-role: group;
+    }
+  }
+}
diff --git a/gnome-initial-setup/pages/ubuntu-pro/meson.build b/gnome-initial-setup/pages/ubuntu-pro/meson.build
new file mode 100644
index 0000000..e1b84d5
--- /dev/null
+++ b/gnome-initial-setup/pages/ubuntu-pro/meson.build
@@ -0,0 +1,27 @@
+blueprint_compiler = find_program('blueprint-compiler')
+
+blueprints = custom_target(
+    'ubuntu-pro-ui-files',
+    input: files(
+        'gis-ubuntupro-attach-page.blp',
+        'gis-ubuntupro-offer-page.blp',
+        'gis-ubuntupro-page.blp',
+        'gis-ubuntupro-services-page.blp',
+    ),
+    output: '.',
+    command: [blueprint_compiler,  'batch-compile', '--minify', '@OUTPUT@', '@CURRENT_SOURCE_DIR@', '@INPUT@'],
+)
+
+sources += gnome.compile_resources(
+    'ubuntupro-resources',
+    files('ubuntupro.gresource.xml'),
+    c_name: 'ubuntupro',
+    dependencies: blueprints,
+)
+
+sources += files(
+    'gis-ubuntupro-page.c',
+    'gis-ubuntupro-page.h',
+    'utils.c',
+    'utils.h',
+)
