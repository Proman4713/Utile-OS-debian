#: po/EXTRA_STRINGS.sh:3
msgid "Try or Install?"
msgstr "Yoxla, yoxsa Qur?"

#: po/EXTRA_STRINGS.sh:4
#, sh-format
msgid ""
"You can try a temporary version of ${NAME} without making changes to the "
"computer. If you decide to install later, just launch the installer from the "
"Activities view.\n"
"\n"
"        Alternatively, choose install to launch the installer."
msgstr ""
"${NAME}-in müvəqqəti versiyasını kompüterdə dəyişiklik etmədən sınaqdan "
"keçirə bilərsiniz. Daha sonra quraşdırmaq istəsəniz, sadəcə Aktivliklər "
"bölməsindən quraşdırıcını başladın.\n"
"\n"
"        Əks halda, birbaşa 'Quraşdır' seçin."

#: po/EXTRA_STRINGS.sh:7
msgid "Install to Disk…"
msgstr "Diskə Quraşdır…"

#: po/EXTRA_STRINGS.sh:8
#, sh-format
msgid "Try ${NAME}"
msgstr "${NAME}-i yoxla"

#: po/EXTRA_STRINGS.sh:9
#, sh-format
msgid "Install ${PRETTY_NAME}"
msgstr "${PRETTY_NAME}-i quraşdır"

