msgstr "管理者名(_N)"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.ui:227
msgid "Administrator Password"
msgstr "管理者パスワード"

#: gnome-initial-setup/pages/account/gis-account-page-enterprise.ui:260
msgid "C_ontinue"
msgstr "続行(_O)"

#: gnome-initial-setup/pages/account/gis-account-page-local.c:225
#, c-format
msgid "The hostname is too long."
msgstr "ホスト名が長すぎます。"

#: gnome-initial-setup/pages/account/gis-account-page-local.c:229
msgid "The hostname must start with a lower case letter from a-z or a digit."
msgstr "ホスト名は、小文字の a ～ z または数字で始める必要があります、"

#: gnome-initial-setup/pages/account/gis-account-page-local.c:233
msgid ""
"The hostname should only consist of lower case letters from a-z, digits and "
"a hyphen: -"
msgstr "ホスト名は、小文字の a ～ z、数字、ハイフン (-) のみで構成してください。"

#: gnome-initial-setup/pages/account/gis-account-page-local.c:574
msgid "We need a few details to complete setup."
msgstr "セットアップを完了するために、いくつかの詳細情報が必要です。"

#: gnome-initial-setup/pages/account/gis-account-page-local.c:737
msgid "Administrator"
msgstr "管理者"

#: gnome-initial-setup/pages/account/gis-account-page-local.c:743
