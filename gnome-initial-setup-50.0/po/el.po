msgstr "Ε_πόμενο"

#: gnome-initial-setup/gis-assistant.c:426
msgid "_Finish"
msgstr "_Ολοκλήρωση"

#: gnome-initial-setup/gis-assistant.c:427
msgid "_Accept"
msgstr "_Αποδοχή"

#: gnome-initial-setup/gis-assistant.c:428
