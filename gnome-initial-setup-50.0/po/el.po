msgid "_Cancel"
msgstr "Α_κύρωση"

#: gnome-initial-setup/gis-webkit.c:54
msgid "Scan the QR Code…"
msgstr "Σάρωση του κωδικού QR…"

#: gnome-initial-setup/gis-webkit.c:244
msgid "Open in default web browser"
msgstr "Άνοιγμα στον προεπιλεγμένο περιηγητή ιστού"

#: gnome-initial-setup/gis-webkit.c:247
msgid "Open in default file handler"
msgstr "Άνοιγμα στον προεπιλεγμένο χειριστή αρχείων"

#: gnome-initial-setup/gnome-initial-setup.c:362
