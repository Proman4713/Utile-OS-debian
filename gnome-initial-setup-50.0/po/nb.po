#, c-format
msgid ""
"Allows apps to determine your geographical location (<u><a "
"href='%1$s'>privacy policy</a></u>)."
msgstr ""

#: gnome-initial-setup/pages/privacy/gis-privacy-page.c:174
#: gnome-initial-setup/pages/privacy/gis-privacy-page.ui:14
#: gnome-initial-setup/pages/privacy/gis-privacy-page.ui:28
msgid "Location Services"
msgstr "Posisjon"

#: gnome-initial-setup/pages/privacy/gis-privacy-page.ui:17
msgid ""
"Turn on location services to let applications know your geographical "
"location."
msgstr ""

#: gnome-initial-setup/pages/privacy/gis-privacy-page.ui:56
msgid "Automatic Problem Reporting"
msgstr "Automatisk feilmelding"

#: gnome-initial-setup/pages/privacy/gis-privacy-page.ui:99
#: gnome-initial-setup/pages/ubuntu-insights/gis-ubuntu-insights-page.blp:134
#: gnome-initial-setup/pages/appearance/gis-appearance-page.blp:138
msgid "You can change this later in the Settings app"
