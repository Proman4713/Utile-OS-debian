msgstr "Kan inte automatiskt ansluta till denna typ av domän"

#: gnome-initial-setup/pages/account/um-realm-manager.c:373
#, c-format
msgid "No such domain or realm found"
msgstr "Ingen sådan domän eller rike hittades"

