#: po/EXTRA_STRINGS.sh:3
msgid "Try or Install?"
msgstr "Vyzkoušet nebo nainstalovat?"

#: po/EXTRA_STRINGS.sh:4
#, sh-format
msgid ""
"You can try a temporary version of ${NAME} without making changes to the "
"computer. If you decide to install later, just launch the installer from the "
"Activities view.\n"
"\n"
"        Alternatively, choose install to launch the installer."
msgstr ""
"Můžete si vyzkoušet dočasnou verzi systému ${NAME}, aniž byste museli "
"provádět změny v počítači. Pokud se jej rozhodnete nainstalovat později, "
"stačí spustit instalační program z přehledu Činností.\n"
"\n"
"      Případně zvolte nainstalovat a spusťte instalační program."

#: po/EXTRA_STRINGS.sh:7
msgid "Install to Disk…"
msgstr "Nainstalovat na disk…"

#: po/EXTRA_STRINGS.sh:8
#, sh-format
msgid "Try ${NAME}"
msgstr "Vyzkoušet ${NAME}"

#: po/EXTRA_STRINGS.sh:9
#, sh-format
msgid "Install ${PRETTY_NAME}"
msgstr "Nainstalovat ${PRETTY_NAME}"

