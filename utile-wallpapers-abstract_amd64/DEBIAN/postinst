#!/bin/bash

set -e # exit if command fails

DCONF_PROFILE="/etc/dconf/profile/user"
mkdir -p /etc/dconf/profile

# avoid double-writing
if [ ! -f "$DCONF_PROFILE" ] || ! grep -q "system-db:local" "$DCONF_PROFILE"; then
    echo "user-db:user" > "$DCONF_PROFILE"
    echo "system-db:local" >> "$DCONF_PROFILE"
fi

if command -v dconf >/dev/null 2>&1; then
    echo "Updating dconf database..."
    dconf update
fi

exit 0