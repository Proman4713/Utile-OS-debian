{
	"$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
	"display": {
		"size": {
			"maxPrefix": "MB",
			"ndigits": 0,
			"spaceBeforeUnit": "never"
		},
		"freq": {
			"ndigits": 3,
			"spaceBeforeUnit": "never"
		},
		"color": {
			"keys": "dim_yellow",
			"output": "white",
			"title": "dim_yellow"
		}
	},
	"modules": [
		"title",
		"separator",
		"os",
		"host",
		{
			"type": "kernel",
			"format": "{release}"
		},
		"uptime",
		{
			"type": "packages",
			"combined": true
		},
		"shell",
		{
			"type": "display",
			"compactType": "original",
			"key": "Resolution"
		},
		"de",
		"wm",
		"wmtheme",
		"theme",
		"icons",
		"terminal",
		{
			"type": "terminalfont",
			"format": "{/name}{-}{/}{name}{?size} {size}{?}"
		},
		"cpu",
		{
			"type": "gpu",
			"key": "GPU",
			"format": "{name}"
		},
		{
			"type": "memory",
			"format": "{used} / {total}"
		},
		"break",
		"colors"
	],
	"logo": {
		"color": {
			"1": "dim_yellow",
			"2": "dim_yellow"
		}
	}
}